# Pandemic Drop & Post-COVID Recovery Rate Calculations
pivot_arr = df_global.pivot(index="country_name", columns="year", values="international_arrivals_millions")
pivot_arr["Drop_2019_to_2020_Pct"] = ((pivot_arr[2020] - pivot_arr[2019]) / pivot_arr[2019] * 100).round(1)
pivot_arr["Rebound_2020_to_2023_Pct"] = ((pivot_arr[2023] - pivot_arr[2020]) / pivot_arr[2020] * 100).round(1)
pivot_arr["Recovery_vs_2019_Pct"] = ((pivot_arr[2023] / pivot_arr[2019]) * 100).round(1)

print("\nPandemic Impact (2019 vs 2020) and Recovery to 2023:")
print(pivot_arr[[2019, 2020, 2023, "Drop_2019_to_2020_Pct", "Recovery_vs_2019_Pct"]].to_string())

